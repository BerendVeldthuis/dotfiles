//"format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
//"format-icons": ["⣀", "⣄", "⣤", "⣦", "⣶", "⣷", "⣿"]
{
    "postition": "top",
    "height": 24,
    "spacing": 0,
    "fixed-center": true,
    "include": [
        "~/.config/waybar/dividers.jsonc"
    ],
    "modules-left": [
        "custom/caps",
        "hyprland/submap",
        "hyprland/windowcount",
        "custom/right-inverse#windowcount",
        "hyprland/workspaces",
        "custom/right",
        "hyprland/window"
    ],
    "modules-center": [],
    "modules-right": [
        "tray",
        "custom/left#tray",
        "pulseaudio",
        "mpris",
        "custom/left-inverse#audio",
        "bluetooth",
        "network",
        "custom/left-inverse#rf",
        "battery",
        "power-profiles-daemon",
        "custom/left-inverse#power",
        "backlight",
        "custom/left-inverse#backlight",
        "clock"
    ],
    //////////////////////
    /// MODULE CONFIGS ///
    //////////////////////
    "custom/caps": {
        "exec": "~/.config/waybar/scripts/capslock.sh",
        "tooltip": false,
        "interval": 1
    },
    "hyprland/workspaces": {
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "tray": "󱊖",
            "audio": "󰤽" 
        }
    },
    "tray":{
        "icon-size": 18,
        "spacing": 2
    },
    "pulseaudio": {
        "format": "{icon}{volume}󱉸",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰖀", "󰕾"]
        },
        "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle"
    },
    "mpris": {
        "interval": 1,
        "format": "{player_icon} {status_icon}",
        "player-icons": {
            "default": "󰧔",
            "vlc": "󰕼",
            "firefox": "󰈹"
        },
        "status-icons": {
            "playing": "󰐊",
            "paused": "󰏤",
            "stopped": "󰓛"
        },
        "tooltip-format": "{player} — {dynamic}"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-on": "󰂯",
        "format-off": "󰂲",
        "format-connected": "{num_connections}",
        "format-disabled": "",
        "tooltip": true,
        "tooltip-format": "",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}{device_battery_percentage}󰏰",
        "on-click": "rofi-bluetooth"
    },
    "network": {
        "interval": 1,
        "format-ethernet": "󰈀",
        "format-wifi": "{icon}",
        "format-disconnected": "󰅛",
        "format-disabled": "󰲛",
        "format-icons": ["󰤯","󰤟","󰤢","󰤥","󰤨"],
        "on-click": "nm-connection-editor",
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-ethernet": "{ipaddr}{bandwidthTotalBytes}",
        "tooltip-format-wifi": "{essid} — {signalStrength}󰏰{ipaddr}{bandwidthTotalBytes}"
    },
    "battery": {
        "format": "󰂁{capacity}󰏰", 
        "format-discharging": "{icon}{capacity}󰏰", 
        "format-charging": "{icon}{capacity}󰏰", 
        "format-full": "󰂄",
        "format-icons": {
            "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"], // nf-md-battery-*
            "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"] // nf-md-battery_chargin_*
        },
        "format-time": "{H}:{M}",
        "tooltip-format-discharging": "Empty in: {time}",
        "tooltip-format-charging": "Full in: {time}",
        "states": {"warning": 15}
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "{profile}",
        "tooltip": true,
        "format-icons": {
            "default": "󰗑",
            "performance": "󱐋",
            "balanced": "󰗑",
            "power-saver": "󰌪"
        }
    }, 
    "backlight": {
        "format": "󰳲{percent}󰏰",
        "tooltip": false
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%Y-%m-%d %H:%M:%S}",
        "on-click": "date '+%Y-%m-%d' | wl-copy",
        "on-click-right": "date '+%Y-%m-%d %H:%M:%S' | wl-copy",
        "interval": 1
    }
}
